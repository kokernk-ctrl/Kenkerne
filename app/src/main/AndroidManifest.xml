<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- O backend único requer um contexto GLES 3.0. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:name=".KenkernApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kenkern">

        <!-- D5 (v0.1.16): screenOrientation era "fullUser" — o app abria em
             VERTICAL no aparelho. sensorLandscape = paisagem automática girando
             com o sensor, as duas laterais. ÚNICA Activity do app (Hub,
             Diagnóstico e editor vivem nela via KenkernAppRoot); nenhum tema ou
             código sobrescreve a orientação (setRequestedOrientation = vazio). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
